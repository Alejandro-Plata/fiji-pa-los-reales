{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "vite.config.ts",
    "vitest.fiji.config.ts",
    "playwright.config.ts",
    "tests",
    "scripts/*.ts",
    "capacitor.config.ts",
    "src/**/*.test.ts",
    "src/global.d.ts",
    "src/utif.d.ts"
  ]
}
