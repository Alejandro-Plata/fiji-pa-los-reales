{
  "name": "fiji-pa-los-reales",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "Genera macros de Fiji a partir de opciones elegidas con botones.",
  "author": "Fiji pa los reales",
  "main": "escritorio/main.cjs",
  "build": {
    "appId": "es.fijipalosreales.app",
    "productName": "Fiji pa los reales",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/descargas/**/*",
      "escritorio/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "escritorio/icono.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fiji pa los reales",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "artifactName": "fiji-pa-los-reales-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "fiji-pa-los-reales-${version}-portable.${ext}"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sinteticas": "py -I scripts/generar-sinteticas.py",
    "validar:fiji": "vitest run --config vitest.fiji.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "iconos": "node scripts/generar-iconos.mjs",
    "android": "npm run build && npx cap sync android",
    "publicar": "node scripts/publicar.mjs",
    "escritorio": "electron .",
    "windows": "node scripts/empaquetar-windows.mjs",
    "capturas": "node scripts/capturas-readme.mjs",
    "capturas:fiji": "node scripts/capturas-fiji.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "utif": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
